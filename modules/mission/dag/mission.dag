module_config {
    module_library : "/apollo/bazel-bin/external/wheelos_mission+/modules/mission/libmission_component.so"
    components {
        class_name : "MissionComponent"
        config {
            name : "mission"
            config_file_path: "/apollo/pkgs/mission/modules/mission/conf/mission_config.pb.txt"
            readers: [
                {
                    channel: "/apollo/mission_request"
                    qos_profile: {
                        depth : 10
                    }
                }
            ]
        }
    }
}
