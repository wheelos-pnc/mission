module_config {
  module_library: "lib/components/mission/libmission_component.so"
  components {
    class_name: "MissionComponent"
    config {
      name: "mission"
      config_file_path: "conf/mission/mission_config.pb.txt"
      readers: [
        {
          channel: "/apollo/mission_request"
          qos_profile: {
            depth: 10
          }
        }
      ]
    }
  }
}
